# Seals the admin session cookie (openssl rand -base64 32)
NUXT_APP_SECRET=
# AES-256 key, base64 (32 bytes), encrypts receivers and tokens. Losing it loses everything.
NUXT_DATA_KEY=
# Public URL used to build personal links
NUXT_PUBLIC_BASE_URL=http://localhost:4000
# Resend API key for bulk sending by email (optional; a sending-only key is enough)
NUXT_RESEND_API_KEY=
# Sender of those emails, on a domain verified at Resend
NUXT_EMAIL_FROM="Under the Tree <gardien@under-the-tree.party>"
# Accounts: addresses that become super-admins on their first login link (comma-separated)
NUXT_SUPER_ADMIN_EMAILS=
# Development only: show the login link on screen instead of only emailing it. Never in production.
NUXT_DEV_LOGIN_LINKS=false
