# Super-admin password (creates groups, names guardians)
SUPER_ADMIN_PASSWORD=
# Seals the admin session cookie (32+ characters)
NUXT_SESSION_PASSWORD=
# AES-256 key, base64, encrypts receivers and tokens. Losing it loses everything.
DATA_KEY=
# Server-side pepper mixed into PIN and password hashes
PIN_PEPPER=
# PBKDF2 iterations (default 50000, Workers cap at 100000)
PBKDF2_ITERATIONS=50000
# Public URL used to build personal links
PUBLIC_BASE_URL=http://localhost:3000
