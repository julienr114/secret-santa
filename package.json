{
  "name": "secret-santa",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "nuxt dev",
    "build": "nuxt build",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare && simple-git-hooks",
    "lint": "eslint --config eslint.config.ts --cache --cache-location node_modules/.cache/eslint/ .",
    "lint:fix": "eslint --config eslint.config.ts . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply secret-santa --local",
    "db:migrate": "wrangler d1 migrations apply secret-santa --remote",
    "deploy:prod": "nuxt build && wrangler deploy",
    "typecheck": "nuxt typecheck",
    "test:e2e": "playwright test",
    "controle": "node --experimental-strip-types --no-warnings scripts/controle.ts",
    "v3:essai": "node --experimental-strip-types --no-warnings --import ./scripts/ts-resolve.mjs scripts/v3-essai.ts",
    "v3:compare": "node --experimental-strip-types --no-warnings --import ./scripts/ts-resolve.mjs scripts/v3-compare.ts",
    "emoji:copy": "node --experimental-strip-types scripts/copy-emoji-images.ts",
    "cle:changer": "node --experimental-strip-types --no-warnings --import ./scripts/ts-resolve.mjs scripts/rotate-key.ts",
    "seed:v3": "node --experimental-strip-types --no-warnings scripts/seed-v3.ts"
  },
  "dependencies": {
    "@internationalized/date": "3.12.4",
    "@nuxt/ui": "^4.13.0",
    "@tanstack/vue-query": "^5.108.3",
    "drizzle-orm": "^0.45.4",
    "nanoid": "^6.0.2",
    "nuxt": "^4.6.4",
    "nuxt-auth-utils": "^0.6.2",
    "vue": "^3.5.46",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@cloudflare/workers-types": "^5.20261123.1",
    "@iconify-json/lucide": "^1.2.158",
    "@nuxt/eslint": "^1.17.0",
    "@playwright/test": "1.65.1",
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^22.20.5",
    "@vitest/coverage-v8": "^5.1.1",
    "drizzle-kit": "^0.31.11",
    "emoji-datasource-apple": "^16.0.0",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-functional": "^10.0.1",
    "fast-check": "^4.11.0",
    "lint-staged": "^17.6.2",
    "prettier": "^3.10.1",
    "simple-git-hooks": "^2.14.0",
    "tailwindcss": "^4.3.5",
    "typescript": "^5.9.3",
    "vitest": "^5.1.1",
    "vue-tsc": "^3.3.14",
    "wrangler": "^4.166.0"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm lint-staged",
    "pre-push": "pnpm test"
  },
  "lint-staged": {
    "*.{js,ts,vue}": [
      "eslint --config eslint.config.ts --fix",
      "prettier --write"
    ],
    "*.{json,css,yml,yaml}": [
      "prettier --write"
    ]
  }
}
